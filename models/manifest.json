{
  "split": {
    "test_size": 0.2,
    "stratify": true,
    "random_state": 42
  },
  "before_improvement": {
    "description": "Lean feature set baselines before richer FE / boosting",
    "models": {
      "before_logistic_regression_lean.joblib": {
        "role": "Stage 1 baseline (linear)",
        "metrics_test": {
          "model": "logistic_regression_lean",
          "accuracy": 0.58025,
          "roc_auc": 0.6090064114565032
        }
      },
      "before_random_forest_lean.joblib": {
        "role": "Stage 2 primary before improvement",
        "metrics_test": {
          "model": "random_forest_lean",
          "accuracy": 0.6133,
          "roc_auc": 0.6658307319318808
        }
      },
      "before_primary_random_forest_lean.joblib": {
        "role": "Alias of before_random_forest_lean.joblib",
        "metrics_test": {
          "model": "random_forest_lean",
          "accuracy": 0.6133,
          "roc_auc": 0.6658307319318808
        }
      }
    },
    "lean_numeric": [
